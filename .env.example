# Maximum answer-generation attempts shared by this single application process per UTC day.
DAILY_ANSWER_CAP=200
# Maximum paid query-embedding calls shared by this single process per UTC day.
DAILY_EMBEDDING_CAP=5000
# Bound simultaneous OpenRouter work so slow providers cannot fill the server's
# worker pool. Requests that cannot obtain a slot quickly fall back to retrieval.
PROVIDER_CONCURRENCY_LIMIT=8
PROVIDER_SLOT_TIMEOUT_SECONDS=0.1
# Railway/proxy deployments should set this to true so per-IP rate limits use
# the first X-Forwarded-For address. Leave false for direct local serving.
TRUST_PROXY_HEADERS=false
# Required only for hosted embeddings, answers, or judge evaluation. Keep it in
# local/Railway secrets; never expose it in browser JavaScript.
# OPENROUTER_API_KEY=
# The generator model, prompt, and settings come only from the hash-bound
# passing-holdout configuration; environment variables cannot override them.
# Optional: enables semantic/hybrid retrieval only when this exact cache matches
# artifacts/section5/frozen_config.json and its selected chunk artifact.
# EMBEDDING_CACHE_PATH=artifacts/section5/embeddings_256_64.npz
